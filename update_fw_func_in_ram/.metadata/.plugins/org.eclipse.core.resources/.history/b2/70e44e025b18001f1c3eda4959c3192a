void UART1_send_1byte(char data)
{
   uint32_t* USART1_SR = (uint32_t*)(0x40013800);
   uint32_t* USART1_DR = (uint32_t*)(0x40013804);
   while ( ((*USART1_SR>>7) & 1) == 0 ); // waiting DR empty
   *USART1_DR=data;
   while ( ((*USART1_SR>>6) & 1) == 0 ); //waiting transmit completion
   *USART1_SR &=~(1<<6); //clear bit TC when transmit done.
}
void UART1_send_string(char *msg)
{
   int msg_lenth =strlen(msg);
   for (int i=0;i < msg_lenth;i++)
   {
      UART1_send_1byte(msg[i]);
      HAL_Delay(1);
   }
}

void uart_printf(char* format, ...)
{
   va_list aptr;
   va_start(aptr, format);
   char buffer[128]={0};
	vsprintf(buffer,format,aptr);
	UART1_send_string(buffer);
	va_end(aptr);
}
char UART1_receive_1byte()
{
   uint32_t* USART1_SR = (uint32_t*)(0x40013800);
   uint32_t* USART1_DR = (uint32_t*)(0x40013804);
   while ( ((*USART1_SR>>5) & 1) == 0 ); // waiting RXNE flag to DR have data
   char recv_data= *USART1_DR; //read data
   return recv_data;

}
int rx_index=0;

void custom_USART1_IRQHandler()
{
   uint32_t* USART1_DR = (uint32_t*)(0x40013804);
   recv_data[rx_index++]=*USART1_DR;
   //note: if RXTN reg have not clear by read DR ( or sth) reg ->  clear it ( read rm)
    if (strstr(recv_data,"led on")!=NULL)
    {
        led_control(1);
        rx_index=0;
        memset(recv_data, 0,sizeof(recv_data));//clear data =0

    }
    else if (strstr(recv_data,"led off")!=NULL)
    {
       led_control(0);
       rx_index=0;
       memset(recv_data, 0,sizeof(recv_data));//clear data =0

    }
}

