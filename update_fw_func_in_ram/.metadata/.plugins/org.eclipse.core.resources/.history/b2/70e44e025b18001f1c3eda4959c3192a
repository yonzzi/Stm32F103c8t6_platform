void led_control(char led_state)
{
   //set led in PB2 light
   // add of output data register
   uint32_t* GPIOB_ODR = (uint32_t*)(GPIOB_BASE_ADD + 0x0C);
   if( led_state==1)
   *GPIOB_ODR |= 1<<2;
   else
    *GPIOB_ODR &= ~(1<<2);
}

