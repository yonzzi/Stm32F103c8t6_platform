void spi_active_slave()
{
	 uint32_t *GPIOA_ODR = (uint32_t*)(0x4001080C);
	 // Set LOW for PA4
	 *GPIOA_ODR &= ~(1<<4);

}

void spi_inactive_slave()
{
	 uint32_t *GPIOA_ODR = (uint32_t*)(0x4001080C);
	 //set HIGH for PA4
	 *GPIOA_ODR |= (1<<4); // it will inactive when set to high

}
void spi_init()
{
	// init for spi master.
	// set PA5( alternate func - SPI1_SCK) , PA6( alternate func - SPI1_MISO), PA7 ( alternate func - SPI1_MOSI)
	 __HAL_RCC_GPIOA_CLK_ENABLE();
	 uint32_t * GPIOA_CRL = (uint32_t *)0x40010800;
	// uint32_t * GPIOA_MAPR = (uint32_t *)0x40010004; // alternate func as SPI1
	 uint32_t *GPIOA_ODR = (uint32_t*)(0x4001080C);

	 *GPIOA_CRL &= ~(0xffff << 16); // clear all offset value
	 *GPIOA_CRL |= 0b1001 << 20; // PA5-SPI1_SCK - alternate func output push pull
	 *GPIOA_CRL |= 0b0100 << 24; // PA6-SPI1_MISO - input floating
	 *GPIOA_CRL |= 0b1001 << 28; // PA7-SPI1_MOSI - alternate func output push pull

	 //*GPIOA_MAPR |=0;

	 //output data for PA6
	 *GPIOA_ODR |=1<<6;

	//set PA4 output mode ( SPI1_NSS )
	 *GPIOA_CRL |= 0b0001 << 16;

	// init spi1 in master
	 __HAL_RCC_SPI1_CLK_ENABLE(); //enable 8MHZ clock for spi

	 uint32_t *SPI1_RG = (uint32_t *)0x40013000;
	 *SPI1_RG |= 1<<2; // select master mode
	 *SPI1_RG |= 0b011<<3; // set baudrate= fclk/16 = 0.5MHZ= 500khzs
	 *SPI1_RG |= 1<<6; // enable spi
	 *SPI1_RG |= (1<<8) | (1<<9); //The value of this bit ( bit 8) is forced onto the NSS pin and the IO value of the NSS pin is ignored.
	                           // use software to control GPIO pin. not hardware ?
	                           //để báo sd chân ngoại vi khác để ddkien select slave này
	 *SPI1_RG |= 1<<6; //enable SPI

	 spi_inactive_slave();

}

char spi_read_data(char reg)
{
	uint32_t *SPI1_DR = (uint32_t *)0x4001300c;
	uint32_t *SPI1_SR = (uint32_t *)0x40013008;

	// active slave - set PA4 to low

	spi_active_slave();

	// send reg to slave - write reg value to DR of SPI1 ( write 0x8F xuống để báo tôi muốn đọc ip data )

	while(((*SPI1_SR >> 1) & 1) ==0);  //wait tx empty to write data to DR
	*SPI1_DR = reg;
	while(((*SPI1_SR >> 1) & 1) ==1); //wait data can be transferred to TX buffer

	while(((*SPI1_SR >> 0) & 1) ==0); //wait RXNE not empty  (tức là có data về RX) to read data
	while(((*SPI1_SR >> 7) & 1) ==1); // wait not busy

	//clear spam data - read data from DR

	uint8_t temp =*SPI1_DR;

	//send clock for slave to slave send data to master. Write dummy data ( 0x00 or 0xff) to DR
    //just need for cyro sensor or spi mode for stm32f104??
/*	while(((*SPI1_SR >> 1) & 1) ==0);  //wait tx empty to write data to DR
	* SPI1_DR = 0xff;
	while(((*SPI1_SR >> 1) & 1) ==1); //wait data can be transferred to TX buffer

	while(((*SPI1_SR >> 0) & 1) ==0); //wait RXNE not empty  (tức là có data về RX) to read data
	while(((*SPI1_SR >> 7) & 1) ==1); // wait not busy

*/

	//read data from DR

    temp=*SPI1_DR;

	// inactive slave - set PA4 to high
	spi_inactive_slave();
	return temp;
}

