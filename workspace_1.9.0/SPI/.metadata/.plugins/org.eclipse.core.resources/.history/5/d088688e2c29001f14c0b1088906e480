void spi_init()
{
	// init for spi master.
	// set PA5( alternate func - SPI1_SCK) , PA6( alternate func - SPI1_MISO), PA7 ( alternate func - SPI1_MOSI)
	 __HAL_RCC_GPIOA_CLK_ENABLE();
	 uint32_t * GPIOA_CRL = (uint32_t *)0x40010800;
	// uint32_t * GPIOA_MAPR = (uint32_t *)0x40010004; // alternate func as SPI1
	 uint32_t *GPIOA_ODR = (uint32_t*)(0x4001080C);

	 *GPIOA_CRL &= ~(0xffff << 16); // clear all offset value
	 *GPIOA_CRL |= 0b0100 << 20; // PA5-SPI1_SCK - input float
	 *GPIOA_CRL |= 0b1001 << 24; // PA6-SPI1_MISO - alter output pushpull
	 *GPIOA_CRL |= 0b0100 << 28; // PA7-SPI1_MOSI - input float

	 //*GPIOA_MAPR |=0;

	 //output data
	 *GPIOA_ODR |= (1<<7) | (1<<4); // pull up ?

	//set PA4 input float mode ( SPI1_NSS )
	 *GPIOA_CRL |= 0b0100 << 16;

	// init spi1 in master
	 __HAL_RCC_SPI1_CLK_ENABLE(); //enable 8MHZ clock for spi

	 uint32_t *SPI1_CR1 = (uint32_t *)0x40013000;
	 *SPI1_CR1 &= ~(1<<2); // select slave mode
	 //*SPI1_CR1 |= 0b011<<3; // set baudrate= fclk/16 = 0.5MHZ= 500khzs
	 *SPI1_CR1 |= (1 << 11); // set 16 bit data frame format
	 //*SPI1_CR1 |= (1<<8) | (1<<9); //The value of this bit ( bit 8) is forced onto the NSS pin and the IO value of the NSS pin is ignored.
	                           // use software to control GPIO pin. not hardware ?
	                           //để báo sd chân ngoại vi khác để ddkien select slave này
	 *SPI1_CR1 |= (0b11 << 0); // CPOL =1, CPAL = 1
	 *SPI1_CR1 |= 1<<6; //enable SPI



}

char *data_receive="";
char *data_receive1="0x34";
void SPI_recieve(){
	uint16_t *SPI1_SR = (uint16_t* )(0x40013008);
	uint16_t *SPI1_DR = (uint16_t* )(0x4001300c);

		//while(((*SPI_SR >> 7) & 1) == 1 );   //  wait not busy
		while(((*SPI1_SR >> 0) & 1) == 0 );  //  wait data be recieve RX buff
		//while(((*SPI_SR >> 6) & 1) == 0 ); // wait not overrun
		data_receive = *SPI1_DR;
		*SPI1_DR = data_receive1;

}

