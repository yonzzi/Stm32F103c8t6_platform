}


void UART_init(){
	__HAL_RCC_GPIOA_CLK_ENABLE();
	__HAL_RCC_USART1_CLK_ENABLE();

	// config PA9 is UART_TX and PA10 is UART_RX
	uint32_t *GPIOA_CRH = (uint32_t *)(GPIOA_BASE + CRH_ADD_OFFSET);
	*GPIOA_CRH &= ~(0xff<<4);  // clear offset value PA9, PA10

	// GPIO configurations for device peripherals UART Full duplex
	*GPIOA_CRH |= (0b1001 <<4);  //  output TX PA9  Alternate function push-pull.
	*GPIOA_CRH |= (0b0100 <<8);  // input floating RX PA10.

	uint32_t *AFIO_MAPR = (uint32_t *)(0x40010000  + 0x04);
	*AFIO_MAPR &= ~(1 <<2); // No remap (use TX/PA9, RX/PA10)

	// baurd rate = 9600, fclk = 8MHz
	uint32_t *USART_BRR = (uint32_t *)(0x40013808);
	*USART_BRR = (52 << 4) |(1);// set baurd rate 9600

	// Parity control
	uint32_t* USART1_CR1 = (uint32_t*)(0x40013800 + 0x0C);
	*USART1_CR1 &= ~(1 << 10); // disable parity control

	// Data length: 8bit data
	*USART1_CR1 &= ~(1 << 12); // set data legth 8 bit

	// enable Receive, Transmit, UART
	*USART1_CR1 |= (1<< 2) | (1<<3) |(1<<13);

/* config  UART1 Receive Interrupt */
	//enable RXNE interrupt-> when RXNE is set , uarrt1 general interuot event send to NVIC
	*USART1_CR1 |= (1 << 5); // A USART interrupt is generated whenever ORE=1 or RXNE=1 in the USART_SR register

	// config NVIC : when UART1 send to interrupt event to NVIC, NVIC have to accept that event so we have to config NVIC
	uint32_t * NVIC_ISER1 = (uint32_t*) (0xE000E100 + 0x04 );
	*NVIC_ISER1 |= (1 << (37-32));  //  enable interupt for event in position 37 vector table (UART1)

}

void UART1_Send_1byte(char data_)
{
	uint32_t* USART1_SR = (uint32_t*)(0x40013800 + 0x00);
	uint32_t* USART1_DR = (uint32_t*)(0x40013804);
// cách 1:
	int TXE , TC;
	TXE = (*USART1_SR >> 7) & 1; // TXE: Transmit data register empty

	do{
	  TXE = (*USART1_SR >> 7) & 1; // TXE: Transmit data register empty
	}
	while ( TXE == 0);           // wait DR empty
	*USART1_DR = data_;
	TC = (*USART1_SR >> 6) & 1; // TC: Transmission complete
	do{
	  TC = (*USART1_SR >> 6) & 1; // TC: Transmission complete
	}
	  while ( TC == 0);   				// wait transmit complete

// cách 2: (nên dùng)
