//	*USART1_DR = data_;
//	while ( ((*USART1_SR >> 6) & 1) == 0);   				// wait transmit complete
//	*USART1_SR &= ~(1<<6);

}

void UART1_Send_string(char *dat)
{
	int data_len = strlen(dat);
	for(int i =0; i< data_len; i++)
	{
		UART1_Send_1byte(dat[i]);
		HAL_Delay(1);
	}
}

char UART1_Receive_1byte(){
	uint32_t* USART1_SR = (uint32_t*)(0x40013800 + 0x00);
	uint32_t* USART1_DR = (uint32_t*)(0x40013804);
	while ( ((*USART1_SR >> 5) & 1) ==0);
	char rec_data = *USART1_DR;
	return rec_data;
}

