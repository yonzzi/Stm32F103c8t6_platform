void custom_EXTI0_IRQHandler(){
	__asm("nop");
	uint32_t *GPIOA_IDR = (uint32_t *)(GPIOA_BASE + IDR_ADD_OFFSET); // button PAO

	unsigned char button_state = *GPIOA_IDR >> 0 & 1 ;
	for(double i = 0; i<1000; i++); // chống nhiễu
