void button_init(){
	__HAL_RCC_GPIOA_CLK_ENABLE();
	// PA0 input
	uint32_t *GPIOA_CRL = (uint32_t *)(GPIOA_BASE + CRL_ADD_OFFSET);
	*GPIOA_CRL &= ~(0b1111<<0);  // clear offset value
	*GPIOA_CRL |= (0b10 <<2); //  input  pull-up/pull-down mode

	uint32_t *GPIOA_ODR = (uint32_t *)(GPIOA_BASE + ODR_ADD_OFFSET);
	*GPIOA_ODR |= (1<<0); // config pull-up mode
}

void led_init() {
	// led pc13
    __HAL_RCC_GPIOC_CLK_ENABLE();
	uint32_t *GPIOC_CRH = (uint32_t *)(GPIOC_BASE + CRH_ADD_OFFSET);
	*GPIOC_CRH &= ~(0b1111<<20);  // clear offset value
	*GPIOC_CRH |= (0b0001<<20);  // output push-pull
}
typedef enum
{
	LED_OFF,
	LED_ON
}led_state;
void led_control(led_state ledstt){
	uint32_t *GPIOC_ODR = (uint32_t *)(GPIOC_BASE + ODR_ADD_OFFSET);
	if(ledstt == LED_ON){
		*GPIOC_ODR &= ~(1 << 13) ;
	}
	else{
		*GPIOC_ODR |= (1 << 13) ;
	}
}


void exti0_init(){
	__HAL_RCC_GPIOA_CLK_ENABLE(); // provide clock

	// config EXTI0
	uint32_t * AFIO_EXTICR1 = (uint32_t*) (0x40010000 + 0x08 );
	*AFIO_EXTICR1 &= ~(1 << 0); // config  EXTI0 is button PA0


	uint32_t * EXTI_RTSR = (uint32_t*) (0x40010400 + 0x08 );
	*EXTI_RTSR |= (1 << 0);  //  choose rsing mode: Rising trigger enabled for EXT0(button PA0)

	uint32_t * EXTI_IMR = (uint32_t*) (0x40010400 + 0x00 );
	*EXTI_IMR |= (1 << 0);  //  enable mask -> ENable EXT0

	// config NVIC : when EXTI0 send to interrupt event to NVIC, NVIC have to accept that event so we have to config NVIC
	uint32_t * NVIC_ISER0 = (uint32_t*) (0xE000E100 + 0x00 );
	*NVIC_ISER0 |= (1 << 6);  //  enable interupt for event in position 6 vector table (EXTI0)

}

