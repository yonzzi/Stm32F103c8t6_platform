#include "main.h"
#include "stdarg.h"
void uart1_init()
{
   __HAL_RCC_GPIOA_CLK_ENABLE();
   //set PA9 as UART1_Tx, PA10 as UART2_Rx
   uint32_t* GPIOA_CRH = (uint32_t*)(0x40010804);// add base + add offset
    //clear reg using
   *GPIOA_CRH &=~(0xff<<4);
   *GPIOA_CRH |= (0b1001 <<4);  //  output TX PA9  Alternate function push-pull.
   *GPIOA_CRH |= (0b0100 <<8);  // input floating RX PA10.

    //set PA9,10 as choose pin
    uint32_t* AFIO_MAPR = (uint32_t*)(0x40010004);
    *AFIO_MAPR &=~(1<<2);//set map for using PA9,10
    //*AFIO_MAPR =(0<<2);      //set map for using PA9,10

//    UART :
//   + baudrate:9600
//   +frame:
//       + data len : 8 bit
//      +parity : none
   __HAL_RCC_USART1_CLK_ENABLE(); // RCC cấp clock cho uart : 8Mhz

   uint32_t* USART1_BRR = (uint32_t*)(0x40013808);
   uint32_t* USART1_CR1 = (uint32_t*)(0x4001380c);

   //*USART1_BRR =(104<<4)|(3<<0); //define div 104.1667
   *USART1_BRR =(52<<4)|(1<<0); //baud 9600 //fck=8M.
   *USART1_CR1 &=~(1<<10) ;//disable parity. if enable -> continue set even or odd in PS position in USART1_CR1 reg
   *USART1_CR1 &=~(1<<12) ; //use 8 bit data

   *USART1_CR1 |=(1<<13)|(1<<2)|(1<<3); //enable tx,rx và uart tổng


   //enable RXNE interr -> when RXNE is set , UART1 generate interr event send to NVIC
   *USART1_CR1 |=(1<<5);

   //NVIC accept interrupt event , Which is send from uart
   uint32_t* NVIC_ISER1 = (uint32_t*)(0xE000E100 + 0x04);
   *NVIC_ISER1 |=(1<<(37-32)); //enable interrupt for event in position 37 in vector table( UART1)


}

static void UART1_send_1byte(char data)
{
	uint32_t* USART1_SR = (uint32_t*)(0x40013800);
	uint32_t* USART1_DR = (uint32_t*)(0x40013804);
	while ( ((*USART1_SR>>7) & 1) == 0 ); // waiting DR empty
	*USART1_DR=data;
	while ( ((*USART1_SR>>6) & 1) == 0 ); //waiting transmit completion
	*USART1_SR &=~(1<<6); //clear bit TC when transmit done.

}

void printlog(char *format,...)
{
	char buf[1024]={0};
	char buf_len =0;
	va_list ap;
	va_start(ap,format);
	vsprintf(buf, format,ap);
	va_end(ap);
	buf_len = strlen(buf);
	for(int i=0; 1< buf_len; i++)
	{
		UART1_send_1byte(buf[i]);
	}
}
