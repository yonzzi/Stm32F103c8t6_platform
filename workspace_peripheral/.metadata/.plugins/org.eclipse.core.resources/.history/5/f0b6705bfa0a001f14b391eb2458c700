void led_init()
{
   //before using any peripheral -> have to give clock for work
   __HAL_RCC_GPIOB_CLK_ENABLE(); //hal : tÃªn hÃ£ng, RCC: bá»™ táº¡o clock
   //initial to set PB2 in output push-pull
   uint32_t* GPIOB_CRH = (uint32_t*)(GPIOB_BASE_ADD + 0x00);// add base + add offset
   *GPIOB_CRH |=(0b01<<8); //set PB2 in output config ( Mode[1,0] >00-> output; =00-> input) // <<22 lÃ  vá»‹ trÃ­ nha, do mÃ¬nh Ä‘á»ƒ cÃ³ 0bxx nÃªn nÃ³ Ä‘ang khÃ´ng lÃ  32 bit, pháº£i dá»‹ch nÃ³ Ä‘á»ƒ Ä‘Ãºng vá»‹ trÃ­
   *GPIOB_CRH &=~(0b11<<10); // set PB2  in push-pull mode (00)

}
void led_control(char led_state)
{
   //set led in PB2 light
   // add of output data register
   uint32_t* GPIOB_ODR = (uint32_t*)(GPIOB_BASE_ADD + 0x0C);
   if( led_state==1)
   *GPIOB_ODR |= 1<<2;
   else
    *GPIOB_ODR &= ~(1<<2);
}

void uart1_init()
{
   __HAL_RCC_GPIOA_CLK_ENABLE();
   //set PA9 as UART1_Tx, PA10 as UART2_Rx
   uint32_t* GPIOA_CRH = (uint32_t*)(0x40010804);// add base + add offset
    //clear reg using
   *GPIOA_CRH &=~(0xff<<4);
   *GPIOA_CRH |= (0b1001 <<4);  //  output TX PA9  Alternate function push-pull.
   *GPIOA_CRH |= (0b0100 <<8);  // input floating RX PA10.

    //set PA9,10 as choose pin
    uint32_t* AFIO_MAPR = (uint32_t*)(0x40010004);
    *AFIO_MAPR &=~(1<<2);//set map for using PA9,10
    //*AFIO_MAPR =(0<<2);      //set map for using PA9,10

//    UART :
//   + baudrate:9600
//   +frame:
//       + data len : 8 bit
//      +parity : none
   __HAL_RCC_USART1_CLK_ENABLE(); // RCC cấp clock cho uart : 16Mhz

   uint32_t* USART1_BRR = (uint32_t*)(0x40013808);
   uint32_t* USART1_CR1 = (uint32_t*)(0x4001380c);

   //*USART1_BRR =(104<<4)|(3<<0); //define div 104.1667
   *USART1_BRR =(52<<4)|(1<<0); //baud 9600 //fck=8M.
   *USART1_CR1 &=~(1<<10) ;//disable parity. if enable -> continue set even or odd in PS position in USART1_CR1 reg
   *USART1_CR1 &=~(1<<12) ; //use 8 bit data

   *USART1_CR1 |=(1<<13)|(1<<2)|(1<<3); //enable tx,rx và uart tổng

#if 0
