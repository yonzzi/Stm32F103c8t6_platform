char recv_data[32];
void uart1_init()
{
	__HAL_RCC_GPIOA_CLK_ENABLE();
	//set PA9 as UART1_Tx, PA10 as UART2_Rx
	uint32_t* GPIOA_CRH = (uint32_t*)(GPIOA_BASE_ADD + 0x04);// add base + add offset
    //clear reg using
	*GPIOA_CRH &=~(0xff<<4);
	*GPIOA_CRH |=(0b01<<4)|(0b01<<8); //set PA9,10 in output mode ( Mode[1,0] >00-> output; =00-> input) // <<22 là vị trí nha, do mình để có 0bxx nên nó đang không là 32 bit, phải dịch nó để đúng vị trí
    *GPIOA_CRH |=(0b10<<6)|(0b10<<10); // set PA9,10 in alternate functions push pull config

    //set PA9,10 as choose pin
    uint32_t* AFIO_MAPR = (uint32_t*)(0x40010000 + 0x04);
    *AFIO_MAPR &=~(0x1<<2);
    *AFIO_MAPR =(0<<2);		//set map for using PA9,10

//    UART :
//	+ baudrate:9600
//	+frame:
//	    + data len : 8 bit
//		+parity : none
	__HAL_RCC_USART1_CLK_ENABLE(); // RCC cấp clock cho uart : 16Mhz

	uint32_t* USART1_BRR = (uint32_t*)(0x40013808);
	uint32_t* USART1_CR1 = (uint32_t*)(0x4001380c);

	*USART1_BRR |=(104<<4)|(3<<0); //define div 104.1667
	*USART1_CR1 &=~(1<<10) ;//disable parity. if enable -> continue set even or odd in PS position in USART1_CR1 reg
	*USART1_CR1 &=~(1<<12) ; //use 8 bit data

	*USART1_CR1 |=(1<<13)|(1<<2)|(1<<3); //enable tx,rx và uart tổng
}

void UART1_send_1byte(char data)
{
	uint32_t* USART1_SR = (uint32_t*)(0x40013800);
	uint32_t* USART1_DR = (uint32_t*)(0x40013804);
	while ( ((*USART1_SR>>7) & 1) == 0 ); // waiting DR empty
	*USART1_DR=data;
	while ( ((*USART1_SR>>6) & 1) == 0 ); //waiting transmit completion
	*USART1_SR &=~(1<<6); //clear bit TC when transmit done.

}
void UART1_send_string(char *msg)
{
	int msg_lenth =strlen(msg);
	for (int i=0;i < msg_lenth;i++)
		UART1_send_1byte(msg[i]);
}
char UART1_receive_1byte()
{
	uint32_t* USART1_SR = (uint32_t*)(0x40013800);
	uint32_t* USART1_DR = (uint32_t*)(0x40013804);
	while ( ((*USART1_SR>>5) & 1) == 0 ); // waiting RXNE flag to DR have data
	char data_rec= *USART1_DR; //read data
	return data_rec;

}
