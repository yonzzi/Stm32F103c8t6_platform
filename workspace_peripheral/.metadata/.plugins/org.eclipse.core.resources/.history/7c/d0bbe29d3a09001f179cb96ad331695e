#define GPIOA_BASE_ADD 0x40010800
#define EXTI_BASE_ADD 0x40010400

//initiale PA0 as input
void button_init()
{
	//before using any peripheral -> have to give clock for work
	__HAL_RCC_GPIOA_CLK_ENABLE(); //hal : tên hãng, RCC: bộ tạo clock
	//initial to set PA0 in floating - as dont has button -> have no dtro noi
	uint32_t* GPIOA_CRH = (uint32_t*)(GPIOA_BASE_ADD + 0x00);// add base + add offset
	*GPIOA_CRH &=~(0b11<<0); //set PA0 in input config ( Mode[1,0] >00-> output; =00-> input) // <<22 là vị trí nha, do mình để có 0bxx nên nó đang không là 32 bit, phải dịch nó để đúng vị trí
	*GPIOA_CRH |=(0b01<<2); // set PA0  in float mode (01)

}
char read_button_state()
{
	uint32_t* GPIOA_IDR = (uint32_t*)(0x40010808);// add base + add offset
	return (*GPIOA_IDR >>0 & 1); //read PA0 input data
}
void exti0_init()
{
	__HAL_RCC_GPIOA_CLK_ENABLE();
	//define mask - cửa thông để cho tín hiệu đi gửi lên
	uint32_t* EXTI_IMR = (uint32_t*)(EXTI_BASE_ADD + 0x00);
	//define add of using catch rising event
	uint32_t* EXTI_RTSR = (uint32_t*)(EXTI_BASE_ADD + 0x08);
	*EXTI_RTSR |=(1<<0); //set rising for EXTI0
	*EXTI_IMR |=(1<<0); //enable EXTI0

	//make sure NVIC tiếp nhận signal từ exti0 gửi lên
	//define addr of NVIC
	uint32_t* NVIC_ISER0 = (uint32_t*)(0xE000E100 + 0x00);
	*NVIC_ISER0 |=(1<<6); //enable interrupt for event in position 6 in vector table( EXTI0)


}
//hàm này là sẵn trong file startup nó đk đặt vào trong địa chỉ của ngắt -> chỉ cần g�?i ra sài
void EXTI0_IRQHandler()
{
	//call asm to put breakpoint -> check interrupt work or not
	__asm("nop");
	//clear pending when interrupt finished
	uint32_t* EXTI_PR = (uint32_t*)(EXTI_BASE_ADD + 0x14);
    *EXTI_PR |=(1<<0); //clear interrupt event flag

}
//tự viết 1 hàm sau đó đặt vào thanh ghi ngắt
void custom_exti0_handler()
{
	//call asm to put breakpoint -> check interrupt work or not
    __asm("nop");
    //clear pending when interrupt finished
    uint32_t* EXTI_PR = (uint32_t*)(EXTI_BASE_ADD + 0x14);
	*EXTI_PR |=(1<<0); //clear interrupt event flag
}
