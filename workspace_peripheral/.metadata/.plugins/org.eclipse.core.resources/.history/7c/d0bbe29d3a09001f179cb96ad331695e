	//copy vector table to ram ( start from 0x20000000)
	uint8_t* ram=(uint8_t*)(0x20000000);
	uint8_t* vttb=(uint8_t*)(0x00000000);
	for(int i=0;i<0x150;i++)
		ram[i]=vttb[i];

	//or using just this funct
	//memcpy(0x20000000,0x00000000,0x150);

	//talk to arm goto ram to find vector table
	uint32_t* VTOR=(uint32_t*)0xE000ED08;
	*VTOR= 0x20000000;
	//register func handler addr into 0x58 ( ie. EXTI0 address)
	uint32_t* func_address=(uint32_t*)0x20000058;
	*func_address = (uint32_t)(custom_exti0_handler) | 1;
